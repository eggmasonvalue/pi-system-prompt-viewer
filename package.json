{
  "name": "pi-system-prompt-viewer",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Inspect Pi's provider-neutral system footprint and latest provider payload in a scrollable TUI overlay",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "system-prompt",
    "system-context",
    "prompt-inspector",
    "prompt-debugging",
    "tool-definitions",
    "developer-tools",
    "debugging"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/eggmasonvalue/pi-system-prompt-viewer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/eggmasonvalue/pi-system-prompt-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/eggmasonvalue/pi-system-prompt-viewer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/footprint-model.test.ts"
  },
  "files": [
    "assets",
    "extensions",
    "lib",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/eggmasonvalue/pi-system-prompt-viewer/main/assets/system-footprint.png"
  }
}

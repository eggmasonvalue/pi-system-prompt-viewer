  "private": false,
  "description": "Inspect and copy the assembled Pi coding agent system prompt and active tool definitions in a scrollable TUI overlay",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "system-prompt",
    "prompt-inspector",
    "prompt-debugging",
    "tool-definitions",
    "developer-tools",
    "debugging"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/eggmasonvalue/pi-system-prompt-viewer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/eggmasonvalue/pi-system-prompt-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/eggmasonvalue/pi-system-prompt-viewer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "assets",
    "extensions",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": ["./extensions"],
